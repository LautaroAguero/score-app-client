# ======================================
# Variables de Entorno - DESARROLLO LOCAL
# ======================================
# Este archivo se usa cuando corres la app SIN Docker (npm run dev)
# Para Docker, edita el .env en la raíz del proyecto

# API Configuration
# Backend API base URL - usado para todas las llamadas API
# En desarrollo local (sin Docker): http://localhost:4000/api/v1
# En Docker: http://localhost:5000/api/v1 (configurado en docker-compose.yml)
# DO NOT use this URL for static files (images, uploads) - those should use the direct backend URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
